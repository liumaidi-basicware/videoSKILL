{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shotcraft Render Specification",
  "type": "object",
  "required": ["schema_version", "width", "height", "fps", "shots"],
  "properties": {
    "schema_version": {"const": 1},
    "width": {"type": "integer", "minimum": 16},
    "height": {"type": "integer", "minimum": 16},
    "fps": {"type": "integer", "minimum": 1},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "card_id", "durationInFrames", "postproduction"], "properties": {"id": {"type": "string", "minLength": 1}, "card_id": {"type": "string", "minLength": 1}, "durationInFrames": {"type": "integer", "minimum": 1}, "postproduction": {"type": "object"}}}}
  }
}
